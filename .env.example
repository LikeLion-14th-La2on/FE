# 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 커밋되지 않음)

# 백엔드 주소. 배포 서버에 붙일 때는 비우고 아래 프록시를 쓴다 (서버 CORS가 localhost 를 막음)
# 로컬 백엔드를 직접 띄울 때만 http://localhost:8080
VITE_API_BASE_URL=

# 배포 서버 주소 (카톡으로 공유). 넣으면 npm run dev 에서 /api 요청을 이 서버로 대신 보낸다
VITE_API_PROXY_TARGET=http://<서버 IP>

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# Redirect URI 에 http://localhost:5173/oauth/kakao 를 등록해야 한다
VITE_KAKAO_REST_API_KEY=
