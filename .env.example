# 이 파일을 .env.local 로 복사해서 값을 채운다 (.env.local 은 커밋되지 않음)

# 백엔드 주소 (로컬 백엔드 기본값)
VITE_API_BASE_URL=http://localhost:8080

# 배포 서버로 붙여 볼 때: 아래 두 줄로 바꾼다 (/api 요청을 Vite가 배포 서버로 넘겨줘서 CORS 문제가 없다)
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://35.76.148.127

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# Redirect URI 에 http://localhost:5173/oauth/kakao 를 등록해야 한다
VITE_KAKAO_REST_API_KEY=
